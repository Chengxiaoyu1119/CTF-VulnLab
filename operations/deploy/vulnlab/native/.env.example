# VulnLab native single-node mode. The installer bootstraps Node.js 22.23.1 in the data directory.
NODE_ENV=production
VULNLAB_HOST=127.0.0.1
VULNLAB_PORT=6710
VULNLAB_DATA_DIR=/opt/vulnlab/data
# Optional when the service is accessed through a domain or reverse proxy.
# VULNLAB_PUBLIC_URL=https://vulnlab.example.com
# Set true only when a trusted reverse proxy is directly in front of VulnLab.
VULNLAB_TRUST_PROXY=false
VULNLAB_COOKIE_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
VULNLAB_ADMIN_PASSWORD=REPLACE_WITH_A_REAL_ADMIN_PASSWORD
VULNLAB_INSTANCE_MINUTES=60
# Native runtime binaries. Linux x64 can download project-local MariaDB, Java,
# and Python from the runtime preparation endpoint; PHP still comes from the system package manager.
# The Node.js binary used by the service is bootstrapped by install.sh and is not
# configured here.
# PHP remains behind VulnLab's path proxy.
# Node.js, Java and Python labs return a direct runtime port; for remote access,
# bind VULNLAB_RUNTIME_HOST to the server address and allow only trusted clients.
VULNLAB_PHP_BIN=/usr/bin/php
# VULNLAB_PHP_INI=/etc/php/8.3/cli/php.ini
# VULNLAB_NODE_BIN=/usr/bin/node
# Optional overrides for the project-local Java and Python runtimes.
# VULNLAB_JAVA_BIN=/usr/bin/java
# VULNLAB_PYTHON_BIN=/usr/bin/python3
VULNLAB_RUNTIME_HOST=127.0.0.1
VULNLAB_RUNTIME_PORT_START=6800
VULNLAB_RUNTIME_PORT_END=6899
# Required behind an HTTPS public URL when native Node/Java/Python ports are
# exposed over HTTP. The placeholder is replaced for each runtime.
# VULNLAB_RUNTIME_PUBLIC_ORIGIN=http://SERVER_IP:{port}
# Optional external MySQL connection. Leave unset to use project-local MariaDB.
# The account only creates/drops per-instance databases and users.
# VULNLAB_MYSQL_BIN=/usr/bin/mysql
# VULNLAB_MYSQL_HOST=127.0.0.1
# VULNLAB_MYSQL_PORT=3306
# VULNLAB_MYSQL_ADMIN_USER=REPLACE_WITH_MYSQL_ADMIN_USER
# VULNLAB_MYSQL_ADMIN_PASSWORD=REPLACE_WITH_MYSQL_ADMIN_PASSWORD
# VULNLAB_MYSQL_APP_HOST=127.0.0.1
