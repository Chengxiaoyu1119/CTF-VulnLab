[Unit]
Description=VulnLab native single-node service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vulnlab
Group=vulnlab
WorkingDirectory=__VULNLAB_APP_DIR__
EnvironmentFile=/etc/vulnlab/vulnlab.env
Environment=PATH=__VULNLAB_NODE_DIR__:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=__VULNLAB_NODE_BIN__ __VULNLAB_APP_DIR__/dist/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=__VULNLAB_DATA_DIR__

[Install]
WantedBy=multi-user.target
