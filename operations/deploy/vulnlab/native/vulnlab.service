[Unit]
Description=VulnLab native single-node service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vulnlab
Group=vulnlab
WorkingDirectory=/opt/vulnlab/app
EnvironmentFile=/etc/vulnlab/vulnlab.env
ExecStart=/usr/bin/node /opt/vulnlab/app/dist/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/vulnlab/data

[Install]
WantedBy=multi-user.target
